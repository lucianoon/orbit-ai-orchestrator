# ===================================
# Manus Orchestrator - Environment Variables
# ===================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control!

# ===== OpenAI API Key =====
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# ===== JWT Authentication =====
# Generate a secure secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-super-secret-jwt-key-here

# ===== CORS =====
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ===== Redis =====
# Only change if running Redis on a different host
REDIS_URL=redis://localhost:6379/1

# ===== LLM Models =====
PLANNER_MODEL=gpt-4.1
VERIFIER_MODEL=gpt-4.1

# ===== Optional: SearXNG =====
SEARX_URL=http://localhost:8080

# ===== Optional: Data Storage =====
# Default is ./orchestrator/data when running locally
APP_DATA_DIR=
HISTORY_DB_PATH=
AUTH_DB_PATH=
